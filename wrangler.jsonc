{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morune-25143",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // 回数制限は補助（場所ごとに数えるため本番では止まらないことがある）。量の上限は1日の上限、見守りはデータベースのまちがい回数で守る
  "ratelimits": [{"name": "STARS_LIMITER", "namespace_id": "25143", "simple": {"limit": 20, "period": 60}}, {"name": "WATCH_LIMITER", "namespace_id": "25144", "simple": {"limit": 5, "period": 60}}],
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "morune-25143",
      "database_id": "d6f01a21-d6b4-4807-bb08-473b2052a7b7",
      "migrations_dir": "drizzle"
    }
  ],
  // 願いの絵（Workers AI：翻訳 m2m100 と、絵 FLUX.1 schnell）。本人が押したときだけ使う
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "CHATGPT_SYNC_ENABLED": "false",
    "PUBLIC_STARS_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  }
}
